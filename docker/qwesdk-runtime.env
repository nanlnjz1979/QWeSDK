# Docker image to pull. Change this to your registry address after publishing.
QWESDK_IMAGE=qwesdk:1.0.3

# Relative to this docker directory. build_qwesdk_package.sh outputs here.
QWESDK_PACKAGE_PATH=../dist

# Writable named volume used only for the runtime SDK overlay. The image and
# /packages remain read-only; the non-root worker writes upgrades here.
QWESDK_INSTALL_TARGET=/var/lib/qwesdk/python

QWESDK_CONTAINER_NAME=qwesdk-worker

# Redis is managed separately and must expose port 6379 on the Docker host.
# Change host, port, password, or database number here when needed.
CELERY_BROKER_URL=redis://host.docker.internal:6379/0
CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/0

CELERY_LOGLEVEL=INFO
CELERY_POOL=prefork
CELERY_CONCURRENCY=2

# Worker sandbox limits. Keep these fixed per deployment and record them with
# the run environment when the Execution Gateway is introduced.
QWESDK_PIDS_LIMIT=64
QWESDK_MEMORY_LIMIT=1g
QWESDK_CPUS=2.0
QWESDK_TMPFS_SIZE=1g
